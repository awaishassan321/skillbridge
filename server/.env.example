# Server port
PORT=5000

# Secret used to sign JWTs — use a long random string in production
# (e.g. `openssl rand -hex 32`), never reuse the dev value.
JWT_SECRET=change_this_to_a_long_random_string

# --- Database ---
# Option A: individual fields (used for local dev)
DB_USER=skillbridge
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skillbridge

# Option B: a single connection string, as most hosted Postgres providers
# (Railway, Render, Supabase, Neon...) give you. When set, this takes
# priority over the DB_* fields above.
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Set to "true" when connecting to a hosted Postgres that requires SSL
DB_SSL=false

# Base URL of the ai-model Flask service
AI_MODEL_URL=http://127.0.0.1:5001

# Deployed frontend origin, to restrict CORS in production.
# Leave unset locally to allow any origin.
# CLIENT_URL=https://your-frontend-domain.com
